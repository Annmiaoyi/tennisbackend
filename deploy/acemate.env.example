# ============================================================================
# AceMate 后端 —— 环境变量
#
#   cp deploy/acemate.env.example deploy/acemate.env
#   然后按下面注释填（至少要填 NETPULSE_INGEST_KEY）
#
# ⚠️ deploy/acemate.env 已在 .gitignore 里，**不要把真实口令提交上去**。
# ⚠️ 这里出现的变量名必须与 server/ 代码真正读取的完全一致 ——
#    写错名字不会报错，应用只当成"没配"、静默走默认值，这是最难查的一类问题。
#    当前代码实际读取的全集（唯一真源见下表的文件）：
#      server/db.py            ACEMATE_DB
#      server/adminauth.py     ACEMATE_ADMIN_PASSWORD(_FILE)
#      server/annotation/db.py NETPULSE_DB, NETPULSE_ANNOTATION_DIR
#      server/rawstore.py      NETPULSE_RAW_DB, NETPULSE_RAW_DIR
#      server/security.py      NETPULSE_INGEST_KEY
#      server/annotation/prod_api.py  WECHAT_APPID, WECHAT_SECRET, NETPULSE_DEV_OPENID
#      （ACEMATE_USER 是设计稿页的默认归属用户，与部署无关）
# ============================================================================


# ---- 时区（请务必设置）-----------------------------------------------------
# ⚠️ 这不是可选项。server/analytics.py 的 resolve_range() 用的是
#    date.today()（朴素本地时间）来算"近 7 天 / 近 30 天"的边界。
#    新装的 Ubuntu 默认是 UTC，比北京时间晚 8 小时 —— 于是每天 00:00~08:00
#    之间，服务端的"今天"还是昨天，所有时间区间筛选会**整体偏一天**。
#    本机开发（GMT+8）看不出这个问题，只有换到 UTC 服务器才会暴露。
TZ=Asia/Shanghai


# ---- 对外绑定地址 ----------------------------------------------------------
# 0.0.0.0     = 局域网内可直接访问 http://<ip>:8787（当前部署用的就是这种）
# 127.0.0.1   = 只听本机，交给 Nginx 反代（配合 deploy/nginx-acemate.conf）
#
# ⚠️ **本文件就是这一项的唯一真源**：ecosystem.config.js 从这里读它来决定 `--host`，
#    bootstrap-server.sh 也 grep 它来判断"采集写口是否对外敞开"。
#    （早先 ecosystem 只读 PM2 进程自己的 process.env，写在文件里是**静默无效**的，已修。）
# ⚠️ 绑定非 127.0.0.1 且 NETPULSE_INGEST_KEY 为空 → `pm2 start` 直接失败（刻意）。
ACEMATE_BIND_HOST=0.0.0.0
#
# 端口一般不用改。真要改就取消注释，bootstrap 的健康检查会跟着读这里：
# ACEMATE_BIND_PORT=8787


# ---- 采集端口令（对外暴露时必填，见下）-------------------------------------
# /api/ingest、/api/raw 是给 Apple Watch / iPhone 采集端用的写接口，
# 它们没有浏览器登录态，只认这个共享口令（HTTP 头 X-Ingest-Key）。
#
# ⚠️ 留空 = 写接口**完全放开**（server/security.py 的"开发期放行"）。
#    应用只会打印一行告警，不会拒绝启动。绑定 0.0.0.0 时这等于把库交给内网任何人。
#
#    生成：openssl rand -hex 24
NETPULSE_INGEST_KEY=


# ---- 数据落盘位置（推荐：全部留空）----------------------------------------
# 留空 = 用代码目录下的 var/，也就是 `run.py` 本机开发时的同一套结构：
#     <项目根>/var/acemate.db                      L2 分析库
#     <项目根>/var/admin_initial_password.txt      初始口令（跟随 ACEMATE_DB 所在目录）
#     <项目根>/var/annotation/annotations.db       L1 标注库
#     <项目根>/var/annotation/video/
#     <项目根>/var/raw/acemate_raw.db              L0 原始库
#     <项目根>/var/raw/files/                      L0 原始载荷（按内容寻址）
#
# 这样三个库跟着代码目录走，迁移时只要搬一个 var/，也不用记路径。
# 只有在**要把数据放到独立数据盘**时才取消注释并改成绝对路径：
#
# ACEMATE_DB=/srv/acemate/data/acemate.db
# NETPULSE_ANNOTATION_DIR=/srv/acemate/data/annotation
# NETPULSE_RAW_DIR=/srv/acemate/data/raw
#
# 注意 NETPULSE_ANNOTATION_DIR / NETPULSE_RAW_DIR 是"整体重定向"，
# 会连带 annotations.db / acemate_raw.db / files/ 一起搬过去；
# 只想挪单个库文件时才用下面这两个更细的：
# NETPULSE_DB=/srv/acemate/data/annotation/annotations.db
# NETPULSE_RAW_DB=/srv/acemate/data/raw/acemate_raw.db
#
# 口令文件默认跟随 ACEMATE_DB 所在目录，一般不用单独设：
# ACEMATE_ADMIN_PASSWORD_FILE=/srv/acemate/data/admin_initial_password.txt


# ---- 初始管理员口令（只对**全新库**生效，迁移过来的库请忽略这一项）--------
# 库里一个账号都没有时，启动会用它创建 admin 账号。
# 好处：口令是你自己定的，不必去翻启动日志或 var/admin_initial_password.txt。
#
# ⚠️ **只对全新库生效**。迁移过来的库已经有 admin 账号了，这一项会被完全忽略
#    —— init() 先查 admin_users 有没有行，有就直接 return，环境变量根本不看。
#    已有库要改口令，用这个（唯一正确入口，别手搓哈希）：
#      .venv/bin/python3 scripts/reset_admin_password.py --password '<新口令≥8位>'
#
# 另：走这一项时**不会**生成 var/admin_initial_password.txt
#     （只有"随机生成"那一支才写文件）。
# ACEMATE_ADMIN_PASSWORD=


# ---- 设计稿页面的默认归属用户（与部署无关，一般不用设）--------------------
# 只影响设计稿页面渲染时的占位归属，不参与鉴权、不影响数据可见性。
# ACEMATE_USER=u_demo


# ---- 微信登录（App / 小程序要微信登录时才需要，否则留空）------------------
# 留空 = /api/wechat/* 不可用，但页面与采集接口不受影响。
WECHAT_APPID=
WECHAT_SECRET=
# 仅联调用：让指定 openid 免登录。生产必须留空。
# NETPULSE_DEV_OPENID=
